# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Required in production: shared secret for GET/POST /api/cron/process-noshow.
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=your_cron_secret

# Required in production: shared secret for /api/seed (creates real users).
# /api/seed returns 404 in production regardless.
SEED_SECRET=your_seed_secret

# Required to create admin accounts. Without it, /admin/login signup is refused.
# This is the main defence against someone self-registering as an organizer.
ADMIN_SIGNUP_CODE=your_admin_signup_code
